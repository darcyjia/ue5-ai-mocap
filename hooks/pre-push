#!/bin/sh
# 推送前跑回归测试（只重跑 clean + qc，约 2 秒）。指标变差则拒绝推送。
# 跳过：git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "[pre-push] python -m aimocap test"
if ! python -m aimocap test > /tmp/aimocap_prepush.log 2>&1; then
  grep -E "FAIL|Error|Traceback" /tmp/aimocap_prepush.log | head -20
  echo "[pre-push] 回归测试没通过，已取消推送。完整日志：/tmp/aimocap_prepush.log"
  exit 1
fi
echo "[pre-push] 回归测试通过"
